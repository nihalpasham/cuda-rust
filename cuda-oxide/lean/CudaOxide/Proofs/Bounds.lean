import Lean
import CudaOxide.Contracts.Access
import CudaOxide.Proofs.Launch

/-!
# Reusable Buffer-Bounds Proofs (`CudaOxide.Proofs.Bounds`)

Reusable lemmas that discharge `no_oob_idx` (`CudaOxide.Contracts.NoOobIdx` and
`CudaOxide.Contracts.NoOobTileAccess`) obligations generated by `lean-exporter`
from `PostMem2Reg` `dialect-mir`.
-/
namespace CudaOxide.Proofs.Bounds
open CudaOxide.Contracts
open CudaOxide.Mir.Kernel

/-- If `i < guardLen` (from an `if` check) and `guardLen ≤ bufferLen` (from
    `requires`), then `i < bufferLen`. -/
theorem index_lt_of_guard {i guardLen bufferLen : Nat}
    (active : i < guardLen) (fits : guardLen ≤ bufferLen) : i < bufferLen := by
  exact Nat.lt_of_lt_of_le active fits                    -- Chain `i < guardLen` and `guardLen ≤ bufferLen`

/-- Proves `no_oob_idx(buf)` for `buf[idx]` when the kernel checks `if idx < guardLen`
    and the launch contract guarantees `guardLen ≤ bufferLen` (e.g., `c.len() ≤ a.len()`). -/
theorem no_oob_idx_of_guard_le {blockSize guardLen bufferLen : Nat}
    (fits : guardLen ≤ bufferLen) :
    NoOobIdx blockSize 0 guardLen bufferLen := by
  intro block lane active                                 -- Unpack `∀ block lane` and guard `active : idx < guardLen`
  simpa using index_lt_of_guard active fits               -- Simplify `idx + 0` to `idx` and apply `index_lt_of_guard`

/-- Proves `no_oob_idx(buf)` for `buf[idx]` when the kernel checks `buf`'s own
    length directly (`if idx < buf.len()`). -/
theorem no_oob_idx_of_same_len {blockSize bufferLen : Nat} :
    NoOobIdx blockSize 0 bufferLen bufferLen := by
  exact no_oob_idx_of_guard_le (Nat.le_refl bufferLen)    -- Special case where `bufferLen ≤ bufferLen` by reflexivity

/-- Proves `no_oob_idx(TILE)` for `TILE[ty * W + tx]`: in-bounds when `tx < W`,
    `ty < H`, and the `H * W` block fits inside `bufferLen`. -/
theorem no_oob_tile_slot {blockDimX blockDimY loopBound bufferLen : Nat}
    (hfit : blockDimY * blockDimX ≤ bufferLen) :
    NoOobTileAccess blockDimX blockDimY loopBound (.threadSlot blockDimX) bufferLen := by
  intro tx ty _i htx hty _hi                                     -- Unpack 2D thread bounds `tx < W` and `ty < H`
  exact CudaOxide.Proofs.Launch.launched_index_fits hty htx hfit -- `ty * W + tx < H * W ≤ bufferLen`

/-- Proves `no_oob_idx(TILE)` for a row scan `TILE[ty * W + i]`: in-bounds when
    `ty < H`, loop step `i < W`, and `H * W ≤ bufferLen`. -/
theorem no_oob_tile_row_scan {blockDimX blockDimY bufferLen : Nat}
    (hfit : blockDimY * blockDimX ≤ bufferLen) :
    NoOobTileAccess blockDimX blockDimY blockDimX (.rowScan blockDimX) bufferLen := by
  intro _tx ty i _htx hty hi                                     -- Unpack row bound `ty < H` and loop step `i < W`
  exact CudaOxide.Proofs.Launch.launched_index_fits hty hi hfit  -- `ty * W + i < H * W ≤ bufferLen`

/-- Proves `no_oob_idx(TILE)` for a column scan `TILE[i * W + tx]`: in-bounds
    when loop step `i < H`, `tx < W`, and `H * W ≤ bufferLen`. -/
theorem no_oob_tile_col_scan {blockDimX blockDimY bufferLen : Nat}
    (hfit : blockDimY * blockDimX ≤ bufferLen) :
    NoOobTileAccess blockDimX blockDimY blockDimY (.colScan blockDimX) bufferLen := by
  intro tx _ty i htx _hty hi                                     -- Unpack col bound `tx < W` and loop step `i < H`
  exact CudaOxide.Proofs.Launch.launched_index_fits hi htx hfit  -- `i * W + tx < H * W ≤ bufferLen`

/-- Proves `no_oob_idx(a)` for a 2D row access `a[start + col]`: in-bounds when
    the row's last element `start + (cols - 1) < bufferLen` and `col < cols`. -/
theorem no_oob_row_strip {bufferLen : Nat} :
    NoOobRowStrip bufferLen := by
  intro _start _cols _col _hpos _hlast _hcol              -- Unpack `start + (cols - 1) < bufferLen` and `col < cols`
  omega                                                   -- Linear solver proves `start + col < bufferLen`

/-- Proves `no_oob_idx(b)` for a 2D column access `b[start + row * stride]`:
    in-bounds when the column's last element `(rows - 1) * stride + start < bufferLen`
    and `row < rows`. -/
theorem no_oob_col_strip {bufferLen : Nat} :
    NoOobColStrip bufferLen := by
  intro _start stride rows row _hpos _hlast _hrow         -- Unpack `(rows - 1) * stride + start < bufferLen` and `row < rows`
  have hle : row ≤ rows - 1 := by omega                   -- Step 1: `row < rows` implies `row ≤ rows - 1`
  have _hmul := Nat.mul_le_mul_right stride hle           -- Step 2: Multiply both sides by `stride`
  omega                                                   -- Step 3: Linear solver combines with `_hlast`

/-- Proves `no_oob_idx(WARP_SUMS)` for a group-slot access `WARP_SUMS[tx / groupSize]`:
    in-bounds when `tx < blockDimX` and `(blockDimX - 1) / groupSize < bufferLen`. -/
theorem no_oob_tile_group_slot {blockDimX blockDimY loopBound groupSize bufferLen : Nat}
    (hpos : 0 < groupSize) (hfit : (blockDimX - 1) / groupSize < bufferLen) :
    NoOobTileAccess blockDimX blockDimY loopBound (.groupSlot groupSize) bufferLen := by
  intro tx _ty _i htx _hty _hi                            -- Unpack `tx < blockDimX`
  simp only [TileAccessPattern.address]                   -- Unfold `.groupSlot groupSize` address to `tx / groupSize`
  have hle : tx ≤ blockDimX - 1 := by omega               -- `tx < blockDimX` implies `tx ≤ blockDimX - 1`
  have hdiv : tx / groupSize ≤ (blockDimX - 1) / groupSize :=
    Nat.div_le_div_right hle                              -- Division by `groupSize` is monotone (`tx / W ≤ (B - 1) / W`)
  exact Nat.lt_of_le_of_lt hdiv hfit                      -- Chain with `(blockDimX - 1) / groupSize < bufferLen`

/-- Proves `no_oob_idx(WARP_SUMS)` for a linear scan `WARP_SUMS[i]`:
    in-bounds when loop step `i < loopBound` and `loopBound ≤ bufferLen`. -/
theorem no_oob_tile_linear_scan {blockDimX blockDimY loopBound bufferLen : Nat}
    (hfit : loopBound ≤ bufferLen) :
    NoOobTileAccess blockDimX blockDimY loopBound .linearScan bufferLen := by
  intro _tx _ty i _htx _hty hi                            -- Unpack loop bound `i < loopBound`
  exact Nat.lt_of_lt_of_le hi hfit                        -- Chain `i < loopBound` with `loopBound ≤ bufferLen`

/-- Proves `no_oob_idx( data)` when the kernel checks `idx / groupSize < guardLen`
    and the launch contract guarantees `guardLen * groupSize ≤ bufferLen`. -/
theorem no_oob_idx_of_div_guard_le {blockSize groupSize guardLen bufferLen : Nat}
    (hpos : 0 < groupSize) (hfit : guardLen * groupSize ≤ bufferLen) :
    NoOobScaledGuard blockSize groupSize guardLen bufferLen := by
  intro block lane hdiv                                   -- Unpack `idx / groupSize < guardLen`
  have hlt : CudaOxide.Mir.globalIndex blockSize block lane < guardLen * groupSize :=
    (Nat.div_lt_iff_lt_mul hpos).1 hdiv                   -- Rewrite `idx / W < guardLen` as `idx < guardLen * W`
  exact Nat.lt_of_lt_of_le hlt hfit                       -- Chain with `guardLen * groupSize ≤ bufferLen`

/-- Proves `no_oob_idx(TILE)` for a 1D thread slot `TILE[tx]` (`blockDimY = 1`)
    when active threads satisfy `tx < activeThreads` and `activeThreads ≤ bufferLen`. -/
theorem no_oob_tile_1d_slot {activeThreads stride loopBound bufferLen : Nat}
    (hfit : activeThreads ≤ bufferLen) :
    NoOobTileAccess activeThreads 1 loopBound (.threadSlot stride) bufferLen := by
  intro tx ty _i htx hty _hi                              -- Unpack `tx < activeThreads` and `ty < 1`
  have hty0 : ty = 0 := by omega                          -- In a 1D block (`blockDimY = 1`), `ty` is `0`
  simp [TileAccessPattern.address, CudaOxide.Mir.globalIndex, hty0] -- Simplify `0 * stride + tx` to `tx`
  exact Nat.lt_of_lt_of_le htx hfit                       -- Chain `tx < activeThreads` with `≤ bufferLen`

/-- Proves `no_oob_idx(TILE)` for packed per-thread accesses `TILE[tx * pack + i]`:
    in-bounds when `tx < activeThreads`, `i < loopBound ≤ pack`, and
    `activeThreads * pack ≤ bufferLen`. -/
theorem no_oob_tile_packed_slot {activeThreads blockDimY loopBound pack bufferLen : Nat}
    (hloop : loopBound ≤ pack) (hfit : activeThreads * pack ≤ bufferLen) :
    NoOobTileAccess activeThreads blockDimY loopBound (.packedSlot pack) bufferLen := by
  intro tx _ty i htx _hty hi                              -- Unpack `tx < activeThreads` and `i < loopBound`
  have hi_pack : i < pack := Nat.lt_of_lt_of_le hi hloop  -- Chain `i < loopBound` with `loopBound ≤ pack`
  exact CudaOxide.Proofs.Launch.launched_index_fits htx hi_pack hfit -- `tx * pack + i < activeThreads * pack ≤ bufferLen`

/-- Proves `no_oob_idx(TILE)` for a sub-warp lane scan `TILE[(tx % groupSize) * pack + i]`:
    in-bounds for any thread `tx` when `0 < groupSize`, `i < loopBound ≤ pack`,
    and `groupSize * pack ≤ bufferLen`. -/
theorem no_oob_tile_group_lane_scan {blockDimX blockDimY loopBound groupSize pack bufferLen : Nat}
    (hpos : 0 < groupSize) (hloop : loopBound ≤ pack)
    (hfit : groupSize * pack ≤ bufferLen) :
    NoOobTileAccess blockDimX blockDimY loopBound (.groupLaneScan groupSize pack) bufferLen := by
  intro tx _ty i _htx _hty hi                             -- Unpack thread `tx` and step `i < loopBound`
  have hrem : tx % groupSize < groupSize := Nat.mod_lt tx hpos -- `tx % groupSize` is strictly `< groupSize`
  have hi_pack : i < pack := Nat.lt_of_lt_of_le hi hloop  -- Chain `i < loopBound` with `loopBound ≤ pack`
  exact CudaOxide.Proofs.Launch.launched_index_fits hrem hi_pack hfit -- `(tx % W) * pack + i < W * pack ≤ bufferLen`

/-- Proves `no_oob_idx(TILE)` for a bit-split 2D slot
    `TILE[(tx / groupSize) * stride + (tx % groupSize)]`: in-bounds when
    `0 < groupSize ≤ stride` and all `(activeThreads - 1) / groupSize + 1` rows fit. -/
theorem no_oob_tile_bit_split_slot {activeThreads blockDimY loopBound groupSize stride bufferLen : Nat}
    (hpos : 0 < groupSize) (hstride : groupSize ≤ stride)
    (hfit : ((activeThreads - 1) / groupSize + 1) * stride ≤ bufferLen) :
    NoOobTileAccess activeThreads blockDimY loopBound (.bitSplitSlot groupSize stride) bufferLen := by
  intro tx _ty _i htx _hty _hi                            -- Unpack `tx < activeThreads`
  have hle : tx ≤ activeThreads - 1 := by omega           -- `tx < activeThreads` implies `tx ≤ activeThreads - 1`
  have hdiv : tx / groupSize < (activeThreads - 1) / groupSize + 1 := by
    have hm : tx / groupSize ≤ (activeThreads - 1) / groupSize :=
      Nat.div_le_div_right hle                            -- Monotonicity of `/ groupSize`
    omega                                                 -- `a ≤ b` implies `a < b + 1`
  have hrem : tx % groupSize < stride :=
    Nat.lt_of_lt_of_le (Nat.mod_lt tx hpos) hstride       -- `tx % groupSize < groupSize ≤ stride`
  exact CudaOxide.Proofs.Launch.launched_index_fits hdiv hrem hfit -- `(tx / W) * stride + (tx % W) < bufferLen`

end CudaOxide.Proofs.Bounds
